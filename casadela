function iconSvg(key){
  const paths = ICONS[key] || ICONS.leaf;
  return `<svg viewBox="0 0 48 48" fill="none" stroke="#F5EFE5" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;
}

/* Gera o markup de um bloco de "imagem" ilustrativa (ícone + legenda discreta) */
function phBlock(key, label){
  return `<div class="ph-icon">${iconSvg(key)}</div><div class="ph-caption">${label || 'Imagem ilustrativa'}</div>`;
}

/* Detecta o ícone mais adequado a partir do nome do item/categoria */
function guessIcon(name){
  const s = name.toLowerCase();
  if(s.includes('café') || s.includes('cafe')) return 'coffee';
  if(s.includes('chá') || s.includes('cha ')) return 'tea';
  if(s.includes('mel')) return 'honey';
  if(s.includes('azeite')) return 'oil';
  if(s.includes('farinha')) return 'grain';
  if(s.includes('castanha') || s.includes('granola') || s.includes('nuts')) return 'nuts';
  if(s.includes('geleia')) return 'jam';
  if(s.includes('biscoito') || s.includes('cookie')) return 'cookie';
  if(s.includes('pão') || s.includes('pao')) return 'bread';
  if(s.includes('queijo')) return 'cheese';
  if(s.includes('chocolate')) return 'chocolate';
  if(s.includes('bolo')) return 'cake';
  if(s.includes('doce') || s.includes('brigadeiro')) return 'sweet';
  if(s.includes('vela')) return 'candle';
  if(s.includes('sabonete')) return 'soap';
  if(s.includes('difusor')) return 'diffuser';
  if(s.includes('cesta')) return 'basket';
  if(s.includes('presente') || s.includes('kit') || s.includes('combo') || s.includes('caixa')) return 'gift';
  if(s.includes('natural')) return 'leaf';
  if(s.includes('artesanal') || s.includes('casa')) return 'bread';
  return 'leaf';
}

