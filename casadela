/* ============ NEWSLETTER (demonstração local — salva no navegador, não é um banco real) ============ */
const NL_KEY = 'casadela_newsletter_demo';
function getEmails(){
  try{ return JSON.parse(localStorage.getItem(NL_KEY)) || []; } catch(e){ return []; }
}
function saveEmail(email){
  const emails = getEmails();
  if(!emails.includes(email)) emails.push(email);
  localStorage.setItem(NL_KEY, JSON.stringify(emails));
  return emails.length;
}
