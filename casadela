/* ============ STATUS ABERTO/FECHADO (America/Sao_Paulo) ============ */
function getSaoPauloNow(){
  const now = new Date();
  const parts = new Intl.DateTimeFormat('en-US', {
    timeZone:'America/Sao_Paulo', weekday:'short', hour:'2-digit', minute:'2-digit', hour12:false
  }).formatToParts(now);
  const map = {};
  parts.forEach(p=> map[p.type]=p.value);
  const weekdayMap = {Sun:0, Mon:1, Tue:2, Wed:3, Thu:4, Fri:5, Sat:6};
  const dayIdx = weekdayMap[map.weekday];
  const hour = parseInt(map.hour,10);
  const minute = parseInt(map.minute,10);
  return { dayIdx, minutes: hour*60+minute };
}

function toMinutes(str){
  const [h,m] = str.split(':').map(Number);
  return h*60+m;
}

function computeStatus(){
  const { dayIdx, minutes } = getSaoPauloNow();
  const today = horarios[dayIdx];

  if(!today.open){
    return { open:false, dayIdx, label: dayIdx===0 ? 'Fechada hoje' : (today.note || 'Fechada hoje') };
  }
  const openMin = toMinutes(today.open);
  const closeMin = toMinutes(today.close);
  const isOpen = minutes >= openMin && minutes < closeMin;
  return {
    open: isOpen,
    dayIdx,
    label: isOpen ? `Aberta agora: ${today.open} - ${today.close}` : 'Fechada no momento'
  };
}

function applyStatus(){
  const status = computeStatus();

  renderHoursList(document.getElementById('hoursList'), status.dayIdx);

  const heroDot = document.getElementById('heroDot');
  const heroText = document.getElementById('heroStatusText');
  const cardDot = document.getElementById('cardDot');
  const cardText = document.getElementById('cardStatusText');

  [heroDot, cardDot].forEach(d=>{
    d.classList.toggle('open', status.open);
    d.classList.toggle('closed', !status.open);
  });
  const emoji = status.open ? '🟢' : '🔴';
  heroText.textContent = `${emoji} ${status.label}`;
  cardText.textContent = `${emoji} ${status.label}`;
}
applyStatus();
