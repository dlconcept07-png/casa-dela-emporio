function renderHoursList(container, currentIdx){
  container.innerHTML = '';
  horarios.slice(1).concat(horarios[0]).forEach(h=>{
    const idx = horarios.indexOf(h);
    const isToday = idx === currentIdx;
    const isUnset = !h.open;
    const text = h.open ? `${h.open} - ${h.close}` : (h.note || 'Fechada');
    container.insertAdjacentHTML('beforeend', `
      <div class="hours-row ${isToday?'today':''} ${isUnset?'unset':''}">
        <span>${h.label}</span><span>${text}</span>
      </div>`);
  });
}

